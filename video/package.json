  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "@remotion/media": "4.0.530",
    "@remotion/transitions": "4.0.530",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "playwright-core": "1.55.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
